# Server Configuration
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Database Connections
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/proxy_redirector_saas?schema=public"
REDIS_URL="redis://localhost:6379"

# Security & Tokens
JWT_ACCESS_SECRET="super-secret-jwt-access-key-32-chars-long"
JWT_REFRESH_SECRET="super-secret-jwt-refresh-key-32-chars-long"
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=604800

# Stripe Payments & Billing
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRO_PRICE_ID="price_..."
STRIPE_BUSINESS_PRICE_ID="price_..."

# Fleet & Engine gRPC
RELAY_HEARTBEAT_TIMEOUT_SEC=90
DEFAULT_BANDWIDTH_LIMIT_GB=50
